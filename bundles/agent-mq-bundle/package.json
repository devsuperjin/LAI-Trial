{
  "name": "@lai/dsh-agent-mq-bundle",
  "description": "Optional message-queue task layer: prompt injection, the MQ runtime, and its Redis Streams backend",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "locale",
    "README.md",
    "README.zh.md",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@lai/dsh-mq": "workspace:*",
    "@lai/dsh-mq-mqtt": "workspace:*",
    "@lai/dsh-mq-rabbitmq": "workspace:*",
    "@lai/dsh-mq-redis": "workspace:*",
    "@lai/dsh-prompt-sections": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}
