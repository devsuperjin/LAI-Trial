{
  "name": "@lai/feishu-tools",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "description": "Feishu tools imported from LJH-snow/dsh-tool-feishu, selectable per LAI specialist.",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": "./lib/web-client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "LICENSE",
    "README.md",
    "UPSTREAM.md",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "@lai/dsh-adapter": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "react": "18.3.1",
    "@types/react": "18.3.28",
    "tsdown": "0.22.14",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
