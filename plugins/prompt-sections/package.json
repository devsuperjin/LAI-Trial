{
  "name": "@lai/dsh-prompt-sections",
  "description": "Configuration-driven system-prompt sections and dynamic contexts registered on the prompt assembly service",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-include": "1.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. plugins/prompt-sections/tests"
  }
}
