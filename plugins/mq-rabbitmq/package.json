{
  "name": "@lai/dsh-mq-rabbitmq",
  "description": "RabbitMQ queue backend for the MQ task runtime with durable queues and manual acknowledgement",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "amqplib": "^0.10.9"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@lai/dsh-mq": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@lai/dsh-mq": "workspace:*",
    "@types/amqplib": "^0.10.7"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. plugins/mq-rabbitmq/tests"
  }
}
