{
  "name": "@lai/dsh-mq-redis",
  "description": "Redis Streams queue backend for the MQ task runtime with consumer-group delivery and acknowledgement",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "ioredis": "^5.4.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@lai/dsh-mq": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-include": "1.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@lai/dsh-mq": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. plugins/mq-redis/tests"
  }
}
